# =============================================================================
# Sift Backend — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# NOTE: Do not paste real API keys into committed files. Keep secrets in `.env`
# (which is gitignored) or your secret manager.

# --- Required (pick one provider) ---

# Provider selector: "google", "groq", or "nvidia"
LLM_PROVIDER=google

# Google Gemini API key for LLM inference
# (Create at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIza...

# Groq API key for LLM inference
# (Create at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# NVIDIA API key for LLM inference (OpenAI-compatible chat completions)
# (Create at https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-...

# --- Optional (defaults work for local development) ---

# LLM model identifier (must match your chosen provider)
# - google:  gemini-2.5-flash (default), gemini-2.5-pro
# - groq:    llama-3.1-70b-versatile
# - nvidia:  meta/llama-3.1-70b-instruct
LLM_MODEL=gemini-2.5-flash

# NVIDIA hosted endpoint base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# Embedding model identifier (HuggingFace model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (inside container: /app/chroma_data)
CHROMA_PERSIST_DIR=./chroma_data

# Maximum number of source adapters to query per research request
MAX_SOURCES_PER_QUERY=5

# Text chunking parameters (tokens)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
